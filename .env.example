# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth/callback
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/auth/callback
# Optional: auth redirect debugging (no PII; logs pathname, hasRedirectUrl, hasNext, isSignedIn)
# AUTH_DEBUG=true

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (server-side only; never expose to client)
OPENAI_API_KEY=

# App URL (for share links; e.g. https://yourapp.com)
NEXT_PUBLIC_APP_URL=

# Rate limiting (optional): use Upstash Redis for production. Without these, in-memory limits are used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin: comma-separated Clerk user IDs allowed to access /app/admin
ADMIN_USER_IDS=

# Optional: feature flags (e.g. Stripe later)
NEXT_PUBLIC_STRIPE_ENABLED=false
